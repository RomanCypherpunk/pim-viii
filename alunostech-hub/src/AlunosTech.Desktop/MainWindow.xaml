<Window x:Class="AlunosTech.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alunos Tech Hub · Back-office" Width="900" Height="560" WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Janela principal do back-office">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Autenticação -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="E-mail" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Width="190" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail"/>
            <TextBlock Text="Senha" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <PasswordBox x:Name="SenhaBox" Width="140" PasswordChanged="SenhaBox_PasswordChanged" AutomationProperties.Name="Senha"/>
            <Button Content="Entrar" Margin="12,0,0,0" Padding="14,2" Command="{Binding LoginCommand}"/>
            <TextBlock Text="{Binding Usuario}" Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Relatório de horas -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Período:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker SelectedDate="{Binding De}" AutomationProperties.Name="Data inicial"/>
            <TextBlock Text="até" VerticalAlignment="Center" Margin="6,0"/>
            <DatePicker SelectedDate="{Binding Ate}" AutomationProperties.Name="Data final"/>
            <Button Content="Gerar relatório" Margin="12,0,0,0" Padding="14,2" Command="{Binding RelatorioCommand}"/>
            <Button Content="Exportar CSV" Margin="8,0,0,0" Padding="14,2" Command="{Binding ExportarCommand}"/>
            <TextBlock Text="Fechar mês:" VerticalAlignment="Center" Margin="24,0,6,0"/>
            <TextBox Width="50" Text="{Binding Ano}" AutomationProperties.Name="Ano"/>
            <TextBox Width="30" Margin="4,0,0,0" Text="{Binding Mes}" AutomationProperties.Name="Mês"/>
            <Button Content="Fechar horas" Margin="8,0,0,0" Padding="14,2" Command="{Binding FecharMesCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Linhas}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Horas por projeto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Projeto" Binding="{Binding Projeto}" Width="2*"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                <DataGridTextColumn Header="Total de horas" Binding="{Binding TotalHoras, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Tarefas" Binding="{Binding Tarefas}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Mensagem de status"/>
    </Grid>
</Window>
